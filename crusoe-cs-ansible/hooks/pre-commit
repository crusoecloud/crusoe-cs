#!/usr/bin/env bash
set -euo pipefail

VENV="${PWD}/.venv/bin"
YAMLLINT="${VENV}/yamllint"
ANSIBLE_LINT="${VENV}/ansible-lint"

echo "→ yamllint"
find . -path './.venv' -prune -o \( -name '*.yml' -o -name '*.yaml' \) -print \
  | xargs "${YAMLLINT}"

echo "→ unit tests"
"${VENV}/python" -m pytest tests/ -q

echo "→ ansible-lint"
"${ANSIBLE_LINT}" .
