# Keep the Docker build context small and deterministic: the roles,
# playbooks, wrappers, and plugins the image bakes, plus the build
# inputs (requirements.yml). Everything else is excluded.
__pycache__/
*.pyc
.venv/
.cache/
logs/
tests/
docs/
inventory/
scripts/
charts/
.vscode/
.*
Pipfile*
ansible.cfg
conftest.py
hooks/
!requirements.yml
README.md
