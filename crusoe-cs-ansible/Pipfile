[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
ansible = ">=9.0"
# Pinned: the pre-release (2.22.0rc2) must not leak into CI; the
# lint job pins ansible-core==2.20.6 — keep them in lockstep.
ansible-core = "==2.21.5"
kubernetes = "*"

[dev-packages]
ansible-lint = "*"
yamllint = "*"
pytest = "*"
# The formatter (canonical) + the linter. CI runs `black --check` +
# `ruff check`; the IDE picks the lint rules from ruff.toml.
black = "*"
ruff = ">=0.8"

[requires]
python_version = "3.14"
