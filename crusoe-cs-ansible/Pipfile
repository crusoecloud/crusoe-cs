[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
ansible = ">=9.0"
# Pinned: the pre-release (2.22.0rc2) must not leak into CI; the
# lint job pins ansible-core==2.20.6 — keep them in lockstep.
ansible-core = "==2.21.5"
kubernetes = "*"

[dev-packages]
ansible-lint = "*"
yamllint = "*"
pytest = "*"
# The formatter + linter + type checker — the same trio CI runs
# (ruff format, ruff check, mypy), all discovering pyproject.toml.
# Black is no longer used anywhere.
ruff = ">=0.8"
mypy = "*"

[requires]
python_version = "3.14"
